<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppCompat 기반 (Material Components 의존성 없이 가볍게 — CLAUDE.md 최소 의존성 원칙).
        NoActionBar + 시맨틱 팔레트로 모던한 카드형 UI 를 구성한다. 다크모드 값은 values-night.
        colorAccent 가 SwitchCompat/SeekBar/RadioButton/EditText 등 위젯 tint 를 일괄 결정한다.

        레이아웃/드로어블/코드는 색을 `@color/...` 가 아니라 `?attr/ui*` 로 참조한다(attrs.xml).
        여기서 각 attr 을 기존 색 리소스에 바인딩하므로 현재 외형은 종전과 100% 동일하고,
        나중에 팔레트만 다르게 바인딩한 테마를 추가하면 런타임 색 교체가 가능해진다.
    -->
    <style name="Theme.LangSense" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorPrimaryDark">@color/ui_bg</item>
        <item name="colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">@color/ui_bg</item>
        <item name="android:statusBarColor">@color/ui_bg</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ui_on_surface</item>
        <item name="android:textColorSecondary">@color/ui_on_surface_muted</item>

        <!-- ── 시맨틱 팔레트 바인딩 (라이트) ────────────────────────── -->
        <item name="uiBg">@color/ui_bg</item>
        <item name="uiSurface">@color/ui_surface</item>
        <item name="uiOnSurface">@color/ui_on_surface</item>
        <item name="uiOnSurfaceMuted">@color/ui_on_surface_muted</item>
        <item name="uiAccent">@color/ui_accent</item>
        <item name="uiOnAccent">@color/ui_on_accent</item>
        <item name="uiAccentContainer">@color/ui_accent_container</item>
        <item name="uiOnAccentContainer">@color/ui_on_accent_container</item>
        <item name="uiDivider">@color/ui_divider</item>
        <item name="uiMuted">@color/ui_muted</item>
        <item name="statusOk">@color/status_ok</item>
        <item name="statusOkContainer">@color/status_ok_container</item>
        <item name="statusNeed">@color/status_need</item>
        <item name="statusNeedContainer">@color/status_need_container</item>
        <!-- 리플: 기존 drawable 에 박혀 있던 리터럴 그대로(동작 불변) -->
        <item name="uiRippleOnAccent">#33FFFFFF</item>
        <item name="uiRippleOnTonal">#332563EB</item>
        <item name="uiStrokeWidth">1dp</item>
    </style>

    <!--
        ══════════════════════════════════════════════════════════════════
        고정 팔레트 테마 3종 (베이지 / 사이버펑크 / 고대비)

        ⚠️ 부모가 DayNight 가 **아니다**(Theme.AppCompat[.Light].NoActionBar).
        이 세 벌은 라이트/다크 개념이 없는 '고정' 팔레트라, DayNight 를 상속하면
        values-night 한정자가 끼어들 여지가 생긴다(지금은 Theme.LangSense 만
        values-night 에 있지만, 나중에 누가 values-night 에 같은 이름을 만들면
        조용히 색이 뒤집힌다). 부모 단계에서 아예 차단해 둔다.
        · 베이지는 밝은 바탕 → Light 계열 부모 + windowLightStatusBar=true
        · 사이버펑크/고대비는 어두운 바탕 → 일반(다크) 부모 + false
          (이걸 잘못 주면 상태바 아이콘이 배경에 묻혀 안 보인다)

        night mode 자체는 `ThemeManager.apply()` 가 팔레트와 같은 쪽으로 고정한다
        (AppCompat 내부 위젯 리소스 — 다이얼로그/커서/오버플로 — 를 맞추기 위함).

        각 테마는 attrs.xml 의 17개 attr 을 **전부** 자기 팔레트로 바인딩한다
        (하나라도 빠지면 부모 AppCompat 에 그 attr 이 없어 런타임에 색이 깨진다).
        ══════════════════════════════════════════════════════════════════
    -->

    <!-- ── 베이지(따뜻한 종이) ────────────────────────────────────────── -->
    <style name="Theme.LangSense.Beige" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/beige_accent</item>
        <item name="colorPrimaryDark">@color/beige_bg</item>
        <item name="colorAccent">@color/beige_accent</item>
        <item name="android:windowBackground">@color/beige_bg</item>
        <item name="android:statusBarColor">@color/beige_bg</item>
        <item name="android:navigationBarColor">@color/beige_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/beige_on_surface</item>
        <item name="android:textColorSecondary">@color/beige_on_surface_muted</item>

        <item name="uiBg">@color/beige_bg</item>
        <item name="uiSurface">@color/beige_surface</item>
        <item name="uiOnSurface">@color/beige_on_surface</item>
        <item name="uiOnSurfaceMuted">@color/beige_on_surface_muted</item>
        <item name="uiAccent">@color/beige_accent</item>
        <item name="uiOnAccent">@color/beige_on_accent</item>
        <item name="uiAccentContainer">@color/beige_accent_container</item>
        <item name="uiOnAccentContainer">@color/beige_on_accent_container</item>
        <item name="uiDivider">@color/beige_divider</item>
        <item name="uiMuted">@color/beige_muted</item>
        <item name="statusOk">@color/beige_status_ok</item>
        <item name="statusOkContainer">@color/beige_status_ok_container</item>
        <item name="statusNeed">@color/beige_status_need</item>
        <item name="statusNeedContainer">@color/beige_status_need_container</item>
        <item name="uiRippleOnAccent">@color/beige_ripple_on_accent</item>
        <item name="uiRippleOnTonal">@color/beige_ripple_on_tonal</item>
        <item name="uiStrokeWidth">1dp</item>
    </style>

    <!-- ── 사이버펑크 ─────────────────────────────────────────────────── -->
    <style name="Theme.LangSense.Cyber" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/cyber_accent</item>
        <item name="colorPrimaryDark">@color/cyber_bg</item>
        <item name="colorAccent">@color/cyber_accent</item>
        <item name="android:windowBackground">@color/cyber_bg</item>
