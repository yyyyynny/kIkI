    </style>

    <!-- ── 고대비 ─────────────────────────────────────────────────────── -->
    <style name="Theme.LangSense.HighContrast" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/hc_accent</item>
