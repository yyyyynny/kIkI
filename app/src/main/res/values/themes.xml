        <item name="uiOnAccentContainer">@color/hc_on_accent_container</item>
        <item name="uiDivider">@color/hc_divider</item>
        <item name="uiMuted">@color/hc_muted</item>
        <item name="statusOk">@color/hc_status_ok</item>
        <item name="statusOkContainer">@color/hc_status_ok_container</item>
