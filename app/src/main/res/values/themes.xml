        <item name="android:textColorPrimary">@color/cyber_on_surface</item>
        <item name="android:textColorSecondary">@color/cyber_on_surface_muted</item>

        <item name="uiBg">@color/cyber_bg</item>
        <item name="uiSurface">@color/cyber_surface</item>
        <item name="uiOnSurface">@color/cyber_on_surface</item>
        <item name="uiOnSurfaceMuted">@color/cyber_on_surface_muted</item>
        <item name="uiAccent">@color/cyber_accent</item>
        <item name="uiOnAccent">@color/cyber_on_accent</item>
        <item name="uiAccentContainer">@color/cyber_accent_container</item>
        <item name="uiOnAccentContainer">@color/cyber_on_accent_container</item>
        <item name="uiDivider">@color/cyber_divider</item>
        <item name="uiMuted">@color/cyber_muted</item>
        <item name="statusOk">@color/cyber_status_ok</item>
