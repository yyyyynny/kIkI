        <item name="uiRippleOnAccent">@color/hc_ripple_on_accent</item>
        <item name="uiRippleOnTonal">@color/hc_ripple_on_tonal</item>
        <!-- 채움이 전부 순흑이라 테두리가 유일한 구분 수단 → 2dp -->
        <item name="uiStrokeWidth">2dp</item>
    </style>
</resources>
