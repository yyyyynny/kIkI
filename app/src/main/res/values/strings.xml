    <string name="settings_badge_text_color">배지 글씨색</string>
    <string name="settings_badge_long_press_desc">배지를 길게 누르면 입력기 선택 창이 바로 열려요. 거기서 원하는 언어(서브타입)를 골라 전환할 수 있어요.</string>
    <string name="badge_long_press_switch_failed">지금은 입력기 선택 창을 열 수 없어요</string>
    <string name="settings_nofocus">포커스 없는 키 입력 경고</string>
    <string name="settings_nofocus_enabled">경고 켜기</string>
    <string name="settings_nofocus_threshold">경고 임계 횟수</string>
    <string name="settings_nofocus_desc">입력칸을 선택하지 않은 채 키보드를 치면 글자가 어디에도 입력되지 않아요. 이때 화면에 경고를 띄워 줍니다.</string>
    <string name="settings_replace">한영타 교체</string>
    <string name="settings_replace_enabled">한영타 교체 켜기</string>
    <string name="settings_replace_confidence">신뢰도 임계값(%)</string>
    <string name="settings_replace_confidence_desc">영문을 한글 자판 배열로 바꿨을 때 올바른 한글 음절로 조합되는 비율이에요. 값이 높을수록 더 확실한 한영타에만 교체 버튼을 띄웁니다. 예를 들어 dkssud 는 안녕 으로 잘 조합돼 높게, 실제 영어 단어는 조합이 깨져 낮게 나옵니다.</string>
    <string name="settings_color_palette_open">팔레트</string>
    <string name="settings_color_palette_close">팔레트 닫기</string>
    <string name="settings_color_hex">색상코드(#RRGGBB)</string>
    <string name="settings_apply">설정이 즉시 적용됩니다</string>
    <string name="settings_back">뒤로</string>
    <string name="settings_saved">저장됨 · 즉시 적용</string>

    <!-- 터치 키보드 제외 (추가 기능 2) -->
    <string name="settings_exclude_touch_kb">터치 키보드 제외</string>
    <string name="settings_exclude_touch_kb_enabled">터치 키보드 제외 켜기</string>
    <string name="settings_exclude_touch_kb_desc">켜면 화면 터치 키보드를 쓰는 동안에는 플래시·배지·경고·교체 기능을 모두 끄고, 블루투스 등 외장 키보드로 입력할 때만 동작합니다. 외장 키보드의 클립보드/추천 툴바만 떠 있는 경우는 터치 키보드로 보지 않아 그대로 동작합니다.</string>
    <string name="settings_keyboard_connect_notify">외장 키보드 연결 알림</string>
    <string name="settings_keyboard_connect_notify_desc">블루투스 등 외장 키보드가 연결되거나 끊길 때 짧게 알려줍니다. 배터리가 나가서 연결이 끊긴 걸 모르고 계속 입력하는 걸 막는 데 도움이 돼요.</string>
    <string name="keyboard_connected_toast">외장 키보드가 연결됐어요</string>
    <string name="keyboard_disconnected_toast">외장 키보드 연결이 끊겼어요</string>
    <string name="settings_diagnostic_pause_with_touch_kb">터치 키보드 사용 중엔 전환 원인 진단도 끄기</string>
    <string name="settings_diagnostic_pause_with_touch_kb_desc">아래 "전환 원인 진단"을 켜둔 경우에만 의미가 있어요. 기본은 꺼져 있어 터치 키보드를 쓰는 동안에도 진단 기록이 계속됩니다 — 켜면 터치 키보드가 떠 있는 동안엔 진단도 함께 멈춰요.</string>

    <!-- 전환 원인 진단 (추가 기능 3) -->
    <string name="settings_diagnostic">전환 원인 진단</string>
    <string name="settings_diagnostic_desc">원인 모를 한/영 자동 전환이 반복될 때 켜보세요. 실제 전환이 감지된 순간 직전에 눌려 있던 물리 키를 기록해 아래에 보여줍니다(예: 삼성 태블릿의 "물리적 키보드 → 언어 전환 바로가기" 설정처럼, 키보드가 아니라 One UI 자체 단축키가 범인인 경우가 많아요). 여러 키가 함께 뜨면 그 순간 타이핑 중이던 다른 키가 섞인 것일 수 있어요 — 그중 의심 가는 키를 하나씩 눌러보며 범인을 좁혀보세요. 다만 시스템이 그 키를 이 앱보다 먼저 가로채면 잡히지 않을 수도 있고, 평소 켜두면 배터리를 조금 더 씁니다 — 원인을 찾았으면 다시 꺼주세요.</string>
    <string name="settings_diagnostic_enabled">전환 키 기록 켜기</string>
    <string name="settings_diagnostic_result_label">최근 감지: %1$s · %2$s</string>
    <string name="settings_diagnostic_result_empty">아직 기록된 전환이 없어요</string>
    <string name="settings_diagnostic_result_unknown">최근 전환(%1$s): 어떤 키가 원인인지 찾지 못했어요 — 시스템이 이 앱보다 먼저 가로챘을 수 있어요</string>
    <string name="settings_diagnostic_clear">지우기</string>

    <!-- 플로팅 메뉴(배지 탭 래디얼 메뉴) -->
    <string name="settings_radial">플로팅 메뉴(배지 탭)</string>
    <string name="settings_radial_reduce_motion">저사양 모드 (움직임 줄이기)</string>
    <string name="settings_radial_reduce_motion_desc">켜면 메뉴를 펼친 뒤 오브가 떠다니는 움직임·별·먼지·선의 흔들림과 유리 블러를 꺼서 펼친 메뉴가 가만히 멈춰 있습니다. 펼치고 접는 동작은 그대로예요. 직접 정하지 않으면 기기 사양(메모리 4GB 이하, 시스템 애니메이션 끔)에 맞춰 자동으로 켜집니다.</string>
    <string name="settings_radial_colors_desc">메뉴의 은은한 색과 발광 색을 원하는 색으로 바꿀 수 있어요.</string>
    <string name="settings_radial_accent_color">메뉴 강조색</string>
    <string name="settings_radial_glow_color">메뉴 발광색</string>

    <!-- 배지 탭 동작 -->
    <string name="settings_badge_tap">배지 탭 동작</string>
    <string name="settings_badge_tap_desc">배지를 탭했을 때 할 일을 고르세요. "메뉴 열기"가 기본이며, 다른 항목을 고르면 탭 한 번에 그 동작이 바로 실행됩니다.</string>
